{
  "name": "neoread",
  "private": true,
  "version": "0.10.0",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && node scripts/dev.mjs",
    "dev:web": "pnpm --filter @neoread/web dev",
    "dev:server": "cd apps/server && go run ./cmd/neoread-server",
    "build": "node scripts/prepare-assets.mjs && pnpm build:agent && pnpm build:processor && pnpm build:server && pnpm --filter @neoread/web build && pnpm --filter @neoread/desktop build && pnpm --filter @neoread/connector build",
    "build:server": "node scripts/build-server.mjs",
    "desktop": "pnpm build && pnpm --filter @neoread/desktop start",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:go && vitest run",
    "test:go": "cd apps/server && go test ./...",
    "api:generate": "openapi-typescript docs/openapi.yaml -o packages/api-client/src/schema.d.ts",
    "format": "prettier --write apps/web/src apps/desktop packages docs scripts",
    "postinstall": "node scripts/prepare-assets.mjs",
    "build:processor": "pnpm --filter @neoread/processor build",
    "package": "node scripts/package.mjs",
    "package:dir": "node scripts/package.mjs --dir",
    "build:agent": "pnpm --filter @neoread/agent build"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0",
    "@types/yazl": "3.3.1"
  }
}
